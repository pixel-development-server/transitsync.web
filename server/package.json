{
  "name": "transitsync-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TransitSync API — JWT auth, RBAC, RFID scan engine, realtime SSE",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/migrate.js --fresh && node src/db/seed.js --demo",
    "relay": "node services/wokwi-relay.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.15.2",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20"
  }
}
