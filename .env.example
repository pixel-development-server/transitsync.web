# ---------------------------------------------------------------------------
# TransitSync server configuration
# Copy to server/.env and adjust. NEVER commit a real .env
# ---------------------------------------------------------------------------

# HTTP port for the API + static client (single-origin, no CORS needed)
PORT=8080

# Interface to bind. 0.0.0.0 listens on every NIC, so phones/tablets on the LAN
# and machines on a Tailscale tailnet can reach the console at
# http://<this-host-ip>:8080. Set to 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0

NODE_ENV=development

# Secret used to sign JWT access tokens. MUST be overridden in production.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# Bootstrap System Administrator created automatically on first migrate/seed.
BOOTSTRAP_ADMIN_EMAIL=admin@transitsync.edu.np
BOOTSTRAP_ADMIN_PASSWORD=TransitSync@2024
BOOTSTRAP_ADMIN_NAME=System Administrator

# Rate limiting
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Request body limit
BODY_LIMIT=1mb

# Where the SQLite database + generated backups live (relative to server/)
DATA_DIR=./data

# Extra allowed CORS origins, comma separated (optional).
# This server also serves the SPA, so its own origin is allowed automatically
# from PORT -- no need to list it here. Only needed for genuinely cross-origin
# clients, e.g. the Vite dev server on 5173 proxying /api during development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Hardware ingest (Wokwi serial -> HTTP relay)
# ---------------------------------------------------------------------------
# Shared secret the relay sends as `x-relay-token` to POST /api/scans/sync.
# When unset, the endpoint only accepts loopback traffic in development and
# refuses in production. The relay reads the same value from this file.
RELAY_TOKEN=transitsync-wokwi-relay-dev-token

# Where the relay forwards device events (defaults to this server's origin).
# TS_API_URL=http://localhost:8080/api/scans/sync

# Relay serial source. Leave all three unset to read from stdin, which is what
# `npx wokwi-cli ... | npm run relay` pipes into. Alternative transports:
#   WOKWI_SERIAL_WS=ws://localhost:9000        (WebSocket serial bridge)
#   WOKWI_SERIAL_PORT=COM3                     (physical reader; needs serialport)
