# ---------------------------------------------------------------------------
# TransitSync server configuration
# Copy to server/.env and adjust. NEVER commit a real .env
# ---------------------------------------------------------------------------

# HTTP port for the API + static client (single-origin, no CORS needed)
PORT=8080

# Interface to bind. 0.0.0.0 listens on every NIC, so phones/tablets on the LAN
# and machines on a Tailscale tailnet can reach the console at
# http://<this-host-ip>:8080. Set to 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0

NODE_ENV=development

# Secret used to sign JWT access tokens. MUST be overridden in production.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# Bootstrap System Administrator created automatically on first migrate/seed.
BOOTSTRAP_ADMIN_EMAIL=admin@transitsync.edu.np
BOOTSTRAP_ADMIN_PASSWORD=TransitSync@2024
BOOTSTRAP_ADMIN_NAME=System Administrator

# ---------------------------------------------------------------------------
# Level 200 Platform Super Administrator (multi-tenant owner)
# ---------------------------------------------------------------------------
# The platform owner is created through the first-run wizard on a fresh install
# (choose your own email/name/password), or by changing the email afterwards in
# Profile > Email address. Environment seeding is opt-in: set
# SUPER_ADMIN_BOOTSTRAP=true and provide the three values below, and the account
# is created once on boot (only when none exists), forced to rotate on first
# sign-in. This account bypasses global maintenance mode and owns the PLATFORM
# MASTER panel (college provisioning, maintenance switch).
SUPER_ADMIN_BOOTSTRAP=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Administrator

# ---------------------------------------------------------------------------
# Email one-time codes (Platform Super Administrator 2FA)
# ---------------------------------------------------------------------------
# Optional. Sets up SMTP so the email second factor can actually deliver codes.
# Without it the email factor still works, but the code is written to the server
# console instead of being mailed. The authenticator-app (TOTP) factor needs no
# SMTP at all.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=TransitSync <no-reply@transitsync.local>

# ---------------------------------------------------------------------------
# Google Sign-In (students + staff; administrators stay on credentials)
# ---------------------------------------------------------------------------
# Create a Google Cloud OAuth client of type "Web application", add
# https://transitsync.me (and http://localhost:5173 for dev) as an authorised
# JavaScript origin, then paste its Client ID here. Leaving it empty hides the
# "Continue with Google" button. The client ID is public; the ID token is always
# verified server-side against Google's signing keys.
#
# ENABLE_GOOGLE_AUTH is the server-side kill switch: false (or 0/no) means the
# /api/auth/google and /api/auth/google/config routes are NOT registered at all.
# The primary self-hosted server sets true. Google-free / fallback deployments
# set false. When unset, a configured client id enables the feature (legacy).
# ENABLE_GOOGLE_AUTH=true
# GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com

# Client build flag (read by Vite, NOT by the server):
#   VITE_ENABLE_GOOGLE_AUTH=true  -> primary build, full features
#   VITE_ENABLE_GOOGLE_AUTH=false -> Git-hosted fallback, no Google code at all
# Set it in the build environment; do not put it in a committed .env file.
# Optional fallback for domains that are not stored in the college registry:
# comma-separated domain:tenantId pairs.
# GOOGLE_DOMAIN_MAP=iic.edu.np:11111111-1111-4111-8111-111111111111

# Rate limiting
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Request body limit
BODY_LIMIT=1mb

# Where generated database backups live (relative to server/)
DATA_DIR=./data

# Extra allowed CORS origins, comma separated (optional).
# This server also serves the SPA, so its own origin is allowed automatically
# from PORT -- no need to list it here. Only needed for genuinely cross-origin
# clients, e.g. the Vite dev server on 5173 proxying /api during development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Hardware ingest (Wokwi serial -> HTTP relay)
# ---------------------------------------------------------------------------
# Shared secret the relay sends as `x-relay-token` to POST /api/scans/sync.
# When unset, the endpoint only accepts loopback traffic in development and
# refuses in production. The relay reads the same value from this file.
RELAY_TOKEN=transitsync-wokwi-relay-dev-token

# Where the relay forwards device events (defaults to this server's origin).
# TS_API_URL=http://localhost:8080/api/scans/sync

# Relay serial source. Leave all three unset to read from stdin, which is what
# `npx wokwi-cli ... | npm run relay` pipes into. Alternative transports:
#   WOKWI_SERIAL_WS=ws://localhost:9000        (WebSocket serial bridge)
#   WOKWI_SERIAL_PORT=COM3                     (physical reader; needs serialport)
